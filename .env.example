# The AI model that writes answers. Default: Groq's free tier (no Hugging Face needed).
# Get a free key at https://console.groq.com/keys
# Locally: copy this file to .env.local and paste your key.
# On Vercel: Project > Settings > Environment Variables. Never commit the real key.
LLM_API_KEY=your_groq_api_key_here

# Optional. Leave these out to use Groq with openai/gpt-oss-120b.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Unlimited and free, on your own computer only (not on Vercel), with Ollama installed:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
